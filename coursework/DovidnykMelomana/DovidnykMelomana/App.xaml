<Application x:Class="DovidnykMelomana.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DovidnykMelomana.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- перший словник – кольори теми; ThemeService замінює саме його -->
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:FavoriteToStarConverter x:Key="FavoriteToStar"/>
            <conv:ListenedToTextConverter x:Key="ListenedToText"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
