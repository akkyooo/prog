<Window x:Class="DovidnykMelomana.Views.AlbumDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Картка альбому" Width="620" Height="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">
    <DockPanel>
        <!-- «Обкладинка»: кольоровий блок із першою літерою назви -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}" Padding="20,16">
            <DockPanel>
                <Border Width="84" Height="84" CornerRadius="42" Background="{DynamicResource AccentBrush}" Margin="0,0,18,0">
                    <Grid>
                        <Ellipse Width="22" Height="22" Fill="{DynamicResource HeaderBackgroundBrush}"/>
                        <Ellipse Width="60" Height="60" Stroke="#40FFFFFF" StrokeThickness="1"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Album.Title}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource HeaderTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Album.ArtistName}" FontSize="15" Margin="0,2,0,0"
                               Foreground="{DynamicResource HeaderTextBrush}" Opacity="0.85"/>
                    <TextBlock Text="{Binding Info}" Margin="0,6,0,0" Foreground="{DynamicResource HeaderTextBrush}" Opacity="0.65"/>
                    <TextBlock Text="{Binding Album.RatingStars}" Margin="0,4,0,0" FontSize="15" Foreground="{DynamicResource StarBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="16,0,16,14">
            <Button DockPanel.Dock="Right" Content="Закрити" Command="{Binding CloseCommand}" IsCancel="True" Padding="18,7" Margin="0"/>
            <Button Content="★ Улюблений / ні" Command="{Binding ToggleFavoriteCommand}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Left"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="16,12,16,6">
            <TextBlock Text="{Binding ArtistInfo}" Style="{StaticResource SubtitleText}"/>
            <TextBlock Text="{Binding Album.Notes}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding Album.Notes, Converter={StaticResource EmptyToCollapsed}}"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource FieldLabel}"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding Album.Tracks}" SelectedItem="{Binding SelectedTrack}" Margin="16,0,16,12"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="26"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Number}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}"/>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="{Binding IsFavorite, Converter={StaticResource FavoriteToStar}}"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource StarBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
