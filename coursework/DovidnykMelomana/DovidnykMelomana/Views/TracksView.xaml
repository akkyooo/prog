<UserControl x:Class="DovidnykMelomana.Views.TracksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="★ Улюблений / ні" Command="{Binding ToggleFavoriteCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0"/>
                <CheckBox DockPanel.Dock="Right" Content="Лише улюблені" IsChecked="{Binding OnlyFavorites}" Margin="16,0"/>
                <TextBlock Text="Пошук треку:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding CounterText}" Style="{StaticResource SubtitleText}" Margin="2,6,0,0"/>

        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="★" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IsFavorite, Converter={StaticResource FavoriteToStar}}"
                                       Foreground="{DynamicResource StarBrush}" FontSize="15" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="№" Binding="{Binding Track.Number}" Width="40"/>
                <DataGridTextColumn Header="Трек" Binding="{Binding Title}" Width="2*" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Тривалість" Binding="{Binding DurationText}" Width="85"/>
                <DataGridTextColumn Header="Альбом" Binding="{Binding AlbumTitle}" Width="1.6*"/>
                <DataGridTextColumn Header="Виконавець" Binding="{Binding ArtistName}" Width="1.3*"/>
                <DataGridTextColumn Header="Рік" Binding="{Binding Year}" Width="55"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
