<UserControl x:Class="DovidnykMelomana.Views.ArtistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список виконавців -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="＋ Додати" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Редагувати" Command="{Binding EditCommand}"/>
                <Button Content="Видалити" Command="{Binding DeleteCommand}" Margin="0"/>
            </StackPanel>
            <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8" ToolTip="Пошук за назвою або країною"/>

            <ListBox ItemsSource="{Binding ArtistsView}" SelectedItem="{Binding SelectedArtist}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <!-- шаблон елемента: назва виконавця і другий рядок із країною та роком -->
                    <DataTemplate>
                        <StackPanel Margin="4,5">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{Binding Country, Mode=OneWay}"/>
                                <Run Text=" · з"/>
                                <Run Text="{Binding CareerStartYear, Mode=OneWay, TargetNullValue='–'}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Картка вибраного виконавця -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding SelectedArtist.Name, FallbackValue='Виконавця не вибрано'}"
                               Style="{StaticResource TitleText}" FontSize="22"/>
                    <TextBlock Text="{Binding SelectedArtistSummary}" Style="{StaticResource SubtitleText}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedArtist.Description}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock Text="Альбоми в довіднику" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding SelectedArtistAlbums}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Рік" Binding="{Binding Year}" Width="60"/>
                        <DataGridTextColumn Header="Альбом" Binding="{Binding Title}" Width="2*"/>
                        <DataGridTextColumn Header="Жанр" Binding="{Binding GenreName}" Width="*"/>
                        <DataGridTextColumn Header="Треків" Binding="{Binding TrackCount}" Width="60"/>
                        <DataGridTextColumn Header="Оцінка" Binding="{Binding RatingStars}" Width="95"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
