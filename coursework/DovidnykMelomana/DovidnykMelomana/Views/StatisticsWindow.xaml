<Window x:Class="DovidnykMelomana.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика колекції" Width="820" Height="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <!-- Плитка з одним показником -->
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Width" Value="180"/>
        </Style>
        <!-- Шаблон рядка смуги: підпис, смуга пропорційної ширини, число -->
        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Height="16" Width="{Binding Width}" CornerRadius="3"
                        Background="{DynamicResource AccentBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Count}" Margin="8,0,0,0" FontWeight="SemiBold"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">
        <Button DockPanel.Dock="Bottom" Content="Закрити" Command="{Binding CloseCommand}" IsCancel="True"
                HorizontalAlignment="Right" Padding="18,7" Margin="0,8,0,0"/>

        <WrapPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Альбомів" Style="{StaticResource SubtitleText}"/>
                    <TextBlock Text="{Binding AlbumCount}" FontSize="26" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Виконавців" Style="{StaticResource SubtitleText}"/>
                    <TextBlock Text="{Binding ArtistCount}" FontSize="26" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Треків / улюблених" Style="{StaticResource SubtitleText}"/>
                    <TextBlock FontSize="26" FontWeight="SemiBold">
                        <Run Text="{Binding TrackCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding FavoriteCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Загальна тривалість" Style="{StaticResource SubtitleText}"/>
                    <TextBlock Text="{Binding TotalDuration}" FontSize="26" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Width="370">
                <StackPanel>
                    <TextBlock Text="Прослухано альбомів" Style="{StaticResource SubtitleText}"/>
                    <TextBlock Text="{Binding ListenedText}" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Width="370">
                <StackPanel>
                    <TextBlock Text="Середня оцінка" Style="{StaticResource SubtitleText}"/>
                    <TextBlock Text="{Binding AverageRating}" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Альбоми за жанрами" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding GenreBars}" ItemTemplate="{StaticResource BarTemplate}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Альбоми за десятиліттями" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding DecadeBars}" ItemTemplate="{StaticResource BarTemplate}"/>
                    <TextBlock Text="П'ять найвище оцінених альбомів" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <ItemsControl ItemsSource="{Binding TopAlbums}"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
