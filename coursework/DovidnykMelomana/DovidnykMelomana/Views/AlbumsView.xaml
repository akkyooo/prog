<UserControl x:Class="DovidnykMelomana.Views.AlbumsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель пошуку та фільтрів -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Пошук і фільтри" Style="{StaticResource TitleText}" FontSize="15"/>

                <TextBlock Text="Назва, виконавець або трек" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Жанр" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding GenreFilterItems}" SelectedItem="{Binding SelectedGenre}"/>

                <TextBlock Style="{StaticResource FieldLabel}">
                    <Run Text="Оцінка не нижча за"/>
                    <Run Text="{Binding MinRating, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                </TextBlock>
                <Slider Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                        TickPlacement="BottomRight" Value="{Binding MinRating}"/>

                <CheckBox Content="Лише непрослухані" IsChecked="{Binding OnlyNotListened}" Margin="0,12,0,0"/>

                <TextBlock Text="Сортування" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}"/>

                <Button Content="Скинути фільтри" Command="{Binding ResetFiltersCommand}" Margin="0,16,0,0"/>

                <TextBlock Text="{Binding CounterText}" Style="{StaticResource SubtitleText}" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <!-- Список альбомів -->
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="＋ Додати альбом" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Редагувати" Command="{Binding EditCommand}"/>
                <Button Content="Видалити" Command="{Binding DeleteCommand}"/>
                <Button Content="Картка альбому" Command="{Binding OpenDetailsCommand}"/>
                <Button Content="Прослухано / ні" Command="{Binding ToggleListenedCommand}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding AlbumsView}" SelectedItem="{Binding SelectedAlbum}" IsReadOnly="True">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenDetailsCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Альбом" Binding="{Binding Title}" Width="2*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Виконавець" Binding="{Binding ArtistName}" Width="1.5*"/>
                    <DataGridTextColumn Header="Рік" Binding="{Binding Year}" Width="55"/>
                    <DataGridTextColumn Header="Жанр" Binding="{Binding GenreName}" Width="1.3*"/>
                    <DataGridTextColumn Header="Носій" Binding="{Binding Format}" Width="75"/>
                    <DataGridTextColumn Header="Треків" Binding="{Binding TrackCount}" Width="60"/>
                    <DataGridTextColumn Header="Тривалість" Binding="{Binding TotalDurationText}" Width="85"/>
                    <DataGridTemplateColumn Header="Оцінка" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RatingStars}" Foreground="{DynamicResource StarBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Прослухано" Binding="{Binding IsListened, Converter={StaticResource ListenedToText}}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
