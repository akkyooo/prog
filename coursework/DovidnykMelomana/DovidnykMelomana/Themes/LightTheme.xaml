<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Світла тема: кольори вінілової обкладинки на світлому тлі -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F1EC"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidePanelBrush" Color="#EAE4DA"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#2B2D42"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#D1495B"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#B23A4B"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#22223B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6C6A73"/>
    <SolidColorBrush x:Key="BorderMainBrush" Color="#D6CFC4"/>
    <SolidColorBrush x:Key="GridHeaderBrush" Color="#EDE7DD"/>
    <SolidColorBrush x:Key="GridAltRowBrush" Color="#FAF8F5"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#F6D5DA"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="StarBrush" Color="#E0A100"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
</ResourceDictionary>
