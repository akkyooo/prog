<Window x:Class="DovidnykMelomana.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DovidnykMelomana.Views"
        Title="Довідник меломана" Width="1180" Height="720" MinWidth="980" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">
    <DockPanel>
        <!-- Верхня панель: назва, користувач, загальні команди -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}" Padding="18,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserName, StringFormat=Користувач: {0}}" VerticalAlignment="Center"
                               Foreground="{DynamicResource HeaderTextBrush}" Opacity="0.8" Margin="0,0,14,0"/>
                    <Button Content="Статистика" Command="{Binding OpenStatisticsCommand}" Style="{StaticResource HeaderButton}"/>
                    <Button Content="Налаштування" Command="{Binding OpenSettingsCommand}" Style="{StaticResource HeaderButton}"/>
                    <Button Content="Вийти" Command="{Binding LogoutCommand}" Style="{StaticResource HeaderButton}" Margin="0"/>
                </StackPanel>
                <TextBlock Text="♫ Довідник меломана" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource HeaderTextBrush}"/>
            </DockPanel>
        </Border>

        <!-- Рядок стану -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidePanelBrush}" Padding="14,5">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>

        <!-- Вкладки: кожна вкладка – окремий UserControl зі своєю ViewModel -->
        <TabControl Margin="14,8,14,10" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Альбоми">
                <views:AlbumsView DataContext="{Binding Albums}" Margin="0,10,0,0"/>
            </TabItem>
            <TabItem Header="Виконавці">
                <views:ArtistsView DataContext="{Binding Artists}" Margin="0,10,0,0"/>
            </TabItem>
            <TabItem Header="Треки">
                <views:TracksView DataContext="{Binding Tracks}" Margin="0,10,0,0"/>
            </TabItem>
            <TabItem Header="Жанри">
                <views:GenresView DataContext="{Binding Genres}" Margin="0,10,0,0"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
