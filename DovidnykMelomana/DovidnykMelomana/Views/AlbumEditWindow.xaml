<Window x:Class="DovidnykMelomana.Views.AlbumEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="900" Height="640" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">
    <DockPanel Margin="16">
        <!-- Кнопки підтвердження -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Зберегти" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" Padding="20,7"/>
                <Button Content="Скасувати" Command="{Binding CancelCommand}" IsCancel="True" Padding="16,7" Margin="0"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorSummary}" Style="{StaticResource ErrorText}" Margin="0,0,12,0" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Відомості про альбом -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Альбом" Style="{StaticResource TitleText}" FontSize="16"/>

                    <TextBlock Text="Назва *" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Виконавець *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Artists}" SelectedItem="{Binding SelectedArtist}" DisplayMemberPath="Name"/>

                    <TextBlock Text="Жанр *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre}" DisplayMemberPath="Name"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Рік виходу *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding YearText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Носій" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Оцінка (0 – без оцінки)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Ratings}" SelectedItem="{Binding Rating}"/>

                    <CheckBox Content="Альбом уже прослухано" IsChecked="{Binding IsListened}" Margin="0,12,0,0"/>

                    <TextBlock Text="Нотатки" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="70"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

            <!-- Трек-лист -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Трек-лист" Style="{StaticResource TitleText}" FontSize="16"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubtitleText}" Margin="0,2,0,8"
                               Text="Тривалість вводьте у форматі хв:сс; порожнє поле – тривалість невідома."/>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TracksSummary}" Style="{StaticResource SubtitleText}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="＋ Трек" Command="{Binding AddTrackCommand}"/>
                            <Button Content="Вилучити" Command="{Binding RemoveTrackCommand}"/>
                            <Button Content="▲" Command="{Binding MoveUpCommand}" ToolTip="Перемістити вище"/>
                            <Button Content="▼" Command="{Binding MoveDownCommand}" ToolTip="Перемістити нижче"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                              CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Назва треку" Width="*"
                                                Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                            <DataGridTextColumn Header="Тривалість" Width="95"
                                                Binding="{Binding DurationText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                            <DataGridCheckBoxColumn Header="Улюблений" Width="85" Binding="{Binding IsFavorite, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
