<Window x:Class="DovidnykMelomana.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Довідник меломана – вхід" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Style="{StaticResource AppWindowStyle}"
        FocusManager.FocusedElement="{Binding ElementName=LoginBox}">
    <StackPanel>
        <!-- Шапка з назвою застосунку -->
        <Border Background="{DynamicResource HeaderBackgroundBrush}" Padding="24,20">
            <StackPanel>
                <TextBlock Text="♫ Довідник меломана" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeaderTextBrush}"/>
                <TextBlock Text="Ваша музична колекція: виконавці, альбоми, треки" Margin="0,4,0,0"
                           Foreground="{DynamicResource HeaderTextBrush}" Opacity="0.75"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="24" Padding="20">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" Margin="0,0,0,6"/>

                <TextBlock Text="Логін" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="LoginBox" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Ім'я для показу в програмі" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged"/>

                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Повторіть пароль" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="ConfirmInput" PasswordChanged="OnConfirmChanged"/>
                    <TextBlock Text="Не менше 6 символів, хоча б одна літера й одна цифра."
                               Style="{StaticResource SubtitleText}" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Background="#1AC0392B" CornerRadius="4" Padding="8,6" Margin="0,12,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyToCollapsed}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                </Border>

                <Button Content="{Binding SubmitText}" Command="{Binding SubmitCommand}"
                        Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Margin="0,16,0,0" Padding="12,8"/>

                <Button Content="{Binding SwitchText}" Command="{Binding SwitchModeCommand}"
                        Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
