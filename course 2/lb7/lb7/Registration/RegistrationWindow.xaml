<Window x:Class="lb7.Registration.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація"
        Height="650"
        Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundColor}">

    <Grid Margin="35">

        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Створення акаунта"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MainColor}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Ім'я" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="FirstNameBox"
                     Style="{StaticResource InputStyle}"/>

            <TextBlock Text="Прізвище" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="LastNameBox"
                     Style="{StaticResource InputStyle}"/>

            <TextBlock Text="Логін" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="LoginBox"
                     Style="{StaticResource InputStyle}"/>

            <TextBlock Text="Електронна пошта" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="EmailBox"
                     Style="{StaticResource InputStyle}"/>

            <TextBlock Text="Пароль" Style="{StaticResource LabelStyle}"/>
            <PasswordBox x:Name="PasswordBox"
                         Style="{StaticResource PasswordStyle}"/>

            <TextBlock Text="Підтвердження пароля"
                       Style="{StaticResource LabelStyle}"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Style="{StaticResource PasswordStyle}"/>

            <Button Content="Зареєструватися"
                    Style="{StaticResource MainButton}"
                    Click="Register_Click"/>

            <Button Content="Уже є акаунт? Увійти"
                    Style="{StaticResource LinkButton}"
                    Margin="0,12,0,0"
                    Click="Authorization_Click"/>

        </StackPanel>

    </Grid>
</Window>