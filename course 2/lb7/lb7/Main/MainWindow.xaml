<Window x:Class="lb7.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Головне вікно"
        Height="430"
        Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundColor}">

    <Grid Margin="35">

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="350">

            <TextBlock Text="Вітаємо!"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MainColor}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Система реєстрації та авторизації користувачів"
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextColor}"
                       Margin="0,0,0,25"/>

            <Button Content="Увійти"
                    Style="{StaticResource MainButton}"
                    Click="Login_Click"/>

            <Button Content="Зареєструватися"
                    Style="{StaticResource MainButton}"
                    Click="Register_Click"/>

            <Button Content="Змінити тему"
                    Style="{StaticResource LinkButton}"
                    Margin="0,18,0,0"
                    Click="Theme_Click"/>

        </StackPanel>

    </Grid>
</Window>