<Application x:Class="lb7.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Main/MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>

            <SolidColorBrush x:Key="MainColor" Color="#635BDB"/>
            <SolidColorBrush x:Key="BackgroundColor" Color="#F3F4FA"/>
            <SolidColorBrush x:Key="TextColor" Color="#25243A"/>
            <SolidColorBrush x:Key="InputBackground" Color="White"/>

            <SolidColorBrush x:Key="GoogleColor" Color="#EA4335"/>
            <SolidColorBrush x:Key="FacebookColor" Color="#1877F2"/>
            <SolidColorBrush x:Key="InstagramColor" Color="#C13584"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>

</Application>