<Window x:Class="lb7.SocialAuthorization.SocialLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Соціальна авторизація"
        Height="370"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundColor}">

    <Grid Margin="30">

        <StackPanel VerticalAlignment="Center">

            <TextBlock x:Name="TitleText"
                       Text="Вхід через сервіс"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MainColor}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <TextBlock Text="Оберіть демонстраційний акаунт:"
                       Style="{StaticResource LabelStyle}"
                       Margin="0,0,0,8"/>

            <ComboBox x:Name="AccountBox"
                      Height="38"
                      FontSize="14"
                      Padding="7"
                      Background="{DynamicResource InputBackground}"
                      Foreground="{DynamicResource TextColor}"
                      Margin="0,0,0,18"/>

            <ProgressBar x:Name="LoadingBar"
                         Height="8"
                         IsIndeterminate="True"
                         Visibility="Collapsed"
                         Margin="0,0,0,10"/>

            <TextBlock x:Name="StatusText"
                       Text=""
                       Foreground="{DynamicResource TextColor}"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

            <Button x:Name="LoginButton"
                    Content="Підтвердити вхід"
                    Style="{StaticResource MainButton}"
                    Click="Login_Click"/>

            <Button Content="Скасувати"
                    Style="{StaticResource LinkButton}"
                    Margin="0,10,0,0"
                    Click="Cancel_Click"/>

        </StackPanel>

    </Grid>
</Window>