<Window x:Class="lb8.Views.CandidateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кандидат"
        Height="700"
        Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Інформація про кандидата"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Прізвище, ім'я та по батькові"/>

            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,15"/>

            <TextBlock Text="Дата народження"/>

            <DatePicker x:Name="BirthDatePicker"
                        SelectedDate="{Binding BirthDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsTodayHighlighted="True"
                        Margin="0,5,0,15"/>

            <TextBlock Text="Освіта"/>

            <ComboBox SelectedValuePath="Content"
                      SelectedValue="{Binding Education, Mode=TwoWay}"
                      Margin="0,5,0,15">

                <ComboBoxItem Content="Середня"/>
                <ComboBoxItem Content="Середня спеціальна"/>
                <ComboBoxItem Content="Вища"/>

            </ComboBox>

            <TextBlock Text="Іноземні мови"
                       FontWeight="Bold"
                       FontSize="16"
                       Margin="0,5,0,10"/>

            <CheckBox Content="Англійська"
                      IsChecked="{Binding English}"
                      Margin="0,5"/>

            <ComboBox SelectedValuePath="Content"
                      SelectedValue="{Binding EnglishLevel, Mode=TwoWay}"
                      IsEnabled="{Binding English}"
                      Margin="20,0,0,10">

                <ComboBoxItem Content="Володію вільно"/>
                <ComboBoxItem Content="Читаю та перекладаю зі словником"/>

            </ComboBox>

            <CheckBox Content="Німецька"
                      IsChecked="{Binding German}"
                      Margin="0,5"/>

            <ComboBox SelectedValuePath="Content"
                      SelectedValue="{Binding GermanLevel, Mode=TwoWay}"
                      IsEnabled="{Binding German}"
                      Margin="20,0,0,10">

                <ComboBoxItem Content="Володію вільно"/>
                <ComboBoxItem Content="Читаю та перекладаю зі словником"/>

            </ComboBox>

            <CheckBox Content="Французька"
                      IsChecked="{Binding French}"
                      Margin="0,5"/>

            <ComboBox SelectedValuePath="Content"
                      SelectedValue="{Binding FrenchLevel, Mode=TwoWay}"
                      IsEnabled="{Binding French}"
                      Margin="20,0,0,10">

                <ComboBoxItem Content="Володію вільно"/>
                <ComboBoxItem Content="Читаю та перекладаю зі словником"/>

            </ComboBox>

            <Separator Margin="0,10"/>

            <CheckBox Content="Володіння комп'ютером"
                      IsChecked="{Binding ComputerSkills}"
                      Margin="0,10"/>

            <TextBlock Text="Стаж роботи (років)"/>

            <ComboBox x:Name="ExperienceBox"
                      SelectedItem="{Binding WorkExperience, Mode=TwoWay}"
                      Margin="0,5,0,15"/>

            <CheckBox Content="Наявність рекомендацій"
                      IsChecked="{Binding Recommendations}"
                      Margin="0,5,0,20"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Зберегти"
                        Width="110"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>

                <Button Content="Скасувати"
                        Width="110"
                        Height="35"
                        IsCancel="True"/>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
