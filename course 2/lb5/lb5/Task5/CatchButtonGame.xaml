<UserControl x:Class="lb5.Task5.CatchButtonGame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid>
        <TextBlock Text="Упіймай кнопку, якщо зможеш!" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10"/>

        <Canvas x:Name="GameCanvas" Margin="10,60,10,10" Background="LightGray">

            <Button x:Name="CatchButton" Content="Натисни мене" Width="130" Height="45" Canvas.Left="100" Canvas.Top="100" MouseEnter="CatchButton_MouseEnter" Click="CatchButton_Click"/>

        </Canvas>
    </Grid>
</UserControl>