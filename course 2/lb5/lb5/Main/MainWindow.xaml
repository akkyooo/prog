<Window x:Class="lb5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:task1="clr-namespace:lb5.Task1"
        xmlns:task2="clr-namespace:lb5.Task2"
        xmlns:task3="clr-namespace:lb5.Task3"
        xmlns:task4="clr-namespace:lb5.Task4"
        xmlns:task5="clr-namespace:lb5.Task5"
        xmlns:task6="clr-namespace:lb5.Task6"
        Title="Лабораторна робота 5"
        Height="550"
        Width="850"
        Background="White"
        Foreground="Black"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">

        <TabControl Background="White" Foreground="Black" BorderBrush="LightGray">

            <TabItem Header="Завдання 1" Background="White" Foreground="Black">
                <task1:Greeting Background="White" Foreground="Black"/>
            </TabItem>

            <TabItem Header="Завдання 2" Background="White" Foreground="Black">
                <task2:VisibilityControl Background="White" Foreground="Black"/>
            </TabItem>

            <TabItem Header="Завдання 3" Background="White" Foreground="Black">
                <task3:TextBoxControl Background="White" Foreground="Black"/>
            </TabItem>

            <TabItem Header="Завдання 4" Background="White" Foreground="Black">
                <task4:ButtonGame Background="White" Foreground="Black"/>
            </TabItem>

            <TabItem Header="Завдання 5" Background="White" Foreground="Black">
                <task5:CatchButtonGame Background="White" Foreground="Black"/>
            </TabItem>

            <TabItem Header="Завдання 6" Background="White" Foreground="Black">
                <task6:ColorAlchemy Background="White" Foreground="Black"/>
            </TabItem>

        </TabControl>

    </Grid>
</Window>
