<UserControl x:Class="lb5.Task3.TextBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

        <TextBox x:Name="InputText" Width="300" Height="40" FontSize="18" Margin="10" Foreground="Black"/>

        <Button Content="Приховати" Width="150" Height="40" Margin="10" Click="HideButton_Click"/>

        <Button Content="Показати" Width="150" Height="40" Margin="10" Click="ShowButton_Click"/>

        <Button Content="Очистити" Width="150" Height="40" Margin="10" Click="ClearButton_Click"/>

    </StackPanel>
</UserControl>