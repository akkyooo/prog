<UserControl x:Class="lb5.Task2.VisibilityControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             Background="White"> 


    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

        <TextBlock x:Name="MessageText" Text="Цей текст можна приховати" FontSize="22" Margin="10" HorizontalAlignment="Center"/>

        <Button Content="Сховати" Width="150" Height="40" Margin="10" Click="HideButton_Click"/>

        <Button Content="Показати" Width="150" Height="40" Margin="10" Click="ShowButton_Click"/>

    </StackPanel>
</UserControl>