<UserControl x:Class="lb5.Task1.Greeting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">

        <Label x:Name="GreetingLabel"
               Content="Початок роботи"
               FontSize="24"
               HorizontalAlignment="Center"
               Margin="10"/>

        <Button Content="Привіт"
                Width="150"
                Height="40"
                Margin="10"
                Click="HelloButton_Click"/>

        <Button Content="До побачення"
                Width="150"
                Height="40"
                Margin="10"
                Click="GoodbyeButton_Click"/>

    </StackPanel>
</UserControl>