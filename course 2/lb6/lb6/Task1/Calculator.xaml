<UserControl x:Class="lb6.Task1.Calculator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#20334D"/>
            <Setter Property="Background" Value="#E3EAF3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#EAF0F6" Margin="20">
        <Border Background="White"
                CornerRadius="15"
                Padding="20"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="КАЛЬКУЛЯТОР"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#20334D"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBox x:Name="HistoryBox"
                         Height="35"
                         FontSize="16"
                         IsReadOnly="True"
                         TextAlignment="Right"
                         BorderThickness="0"
                         Background="#F0F3F7"
                         Foreground="#758397"
                         Padding="8"/>

                <TextBox x:Name="DisplayBox"
                         Height="65"
                         FontSize="30"
                         FontWeight="Bold"
                         IsReadOnly="True"
                         Text="0"
                         TextAlignment="Right"
                         VerticalContentAlignment="Center"
                         BorderThickness="0"
                         Background="#F0F3F7"
                         Foreground="#20334D"
                         Padding="8"
                         Margin="0,5,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Content="C" Tag="C" Grid.Row="0" Grid.Column="0" Click="Button_Click"/>
                    <Button Content="CE" Tag="CE" Grid.Row="0" Grid.Column="1" Click="Button_Click"/>
                    <Button Content="&lt;" Tag="BACK" Grid.Row="0" Grid.Column="2" Click="Button_Click"/>
                    <Button Content="/" Tag="/" Grid.Row="0" Grid.Column="3" Click="Button_Click"/>
                    <Button Content="7" Tag="7" Grid.Row="1" Grid.Column="0" Click="Button_Click"/>
                    <Button Content="8" Tag="8" Grid.Row="1" Grid.Column="1" Click="Button_Click"/>
                    <Button Content="9" Tag="9" Grid.Row="1" Grid.Column="2" Click="Button_Click"/>
                    <Button Content="*" Tag="*" Grid.Row="1" Grid.Column="3" Click="Button_Click"/>
                    <Button Content="4" Tag="4" Grid.Row="2" Grid.Column="0" Click="Button_Click"/>
                    <Button Content="5" Tag="5" Grid.Row="2" Grid.Column="1" Click="Button_Click"/>
                    <Button Content="6" Tag="6" Grid.Row="2" Grid.Column="2" Click="Button_Click"/>
                    <Button Content="-" Tag="-" Grid.Row="2" Grid.Column="3" Click="Button_Click"/>
                    <Button Content="1" Tag="1" Grid.Row="3" Grid.Column="0" Click="Button_Click"/>
                    <Button Content="2" Tag="2" Grid.Row="3" Grid.Column="1" Click="Button_Click"/>
                    <Button Content="3" Tag="3" Grid.Row="3" Grid.Column="2" Click="Button_Click"/>
                    <Button Content="+" Tag="+" Grid.Row="3" Grid.Column="3" Click="Button_Click"/>
                    <Button Content="0" Tag="0" Grid.Row="4" Grid.Column="0" Click="Button_Click"/>
                    <Button Content="." Tag="." Grid.Row="4" Grid.Column="1" Click="Button_Click"/>
                    <Button Content="=" Tag="=" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2"
                            Click="Button_Click"
                            Background="#2878D0"
                            Foreground="White"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>