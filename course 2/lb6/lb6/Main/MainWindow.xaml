<Window x:Class="lb6.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:task1="clr-namespace:lb6.Task1"
        xmlns:task2="clr-namespace:lb6.Task2"
        Title="Лабораторна робота №6"
        Height="700"
        Width="950"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#EAF0F6">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,15">

            <TextBlock Text="Елементи керування WPF"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#20334D"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Лабораторна робота №6"
                       FontSize="14"
                       Foreground="#65758B"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <TabControl Grid.Row="1"
                    FontSize="15"
                    Background="White">

            <TabItem Header="Calculator">
                <task1:Calculator/>
            </TabItem>

            <TabItem Header="BestOil">
                <task2:BestOil/>
            </TabItem>

        </TabControl>

    </Grid>

</Window>