<UserControl x:Class="lb6.Task2.BestOil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#2878D0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="UnitStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#65758B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#EAF0F6" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Header="⛽ Автозаправка"
                      Grid.Column="0"
                      Grid.Row="0"
                      Margin="7"
                      Padding="10"
                      FontSize="15"
                      Background="White">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Пальне"
                               VerticalAlignment="Center"/>

                    <ComboBox x:Name="FuelCombo"
                              Grid.Column="1"
                              Height="30"
                              FontSize="15"
                              Margin="5"
                              SelectedIndex="0"
                              SelectionChanged="FuelCombo_SelectionChanged">
                        <ComboBoxItem Content="А-95"/>
                        <ComboBoxItem Content="А-92"/>
                        <ComboBoxItem Content="Дизель"/>
                    </ComboBox>

                    <TextBlock Text="Ціна"
                               Grid.Row="1"
                               VerticalAlignment="Center"/>

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Height="30"
                            Margin="5"
                            Background="#F0F3F7"
                            BorderBrush="#B8C2CF"
                            BorderThickness="1">
                        <TextBlock x:Name="FuelPriceText"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Margin="6,0"/>
                    </Border>

                    <TextBlock Text="грн/л"
                               Grid.Row="1"
                               Grid.Column="2"
                               Style="{StaticResource UnitStyle}"/>

                    <RadioButton x:Name="LitersMode"
                                 Content="Кількість"
                                 Grid.Row="2"
                                 IsChecked="True"
                                 GroupName="FuelMode"
                                 VerticalAlignment="Center"
                                 Checked="Mode_Checked"/>

                    <TextBox x:Name="LitersBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Text="1"/>

                    <TextBlock Text="л"
                               Grid.Row="2"
                               Grid.Column="2"
                               Style="{StaticResource UnitStyle}"/>

                    <RadioButton x:Name="MoneyMode"
                                 Content="Сума"
                                 Grid.Row="3"
                                 GroupName="FuelMode"
                                 VerticalAlignment="Center"
                                 Checked="Mode_Checked"/>

                    <TextBox x:Name="MoneyBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             Text="100"
                             IsEnabled="False"/>

                    <TextBlock Text="грн"
                               Grid.Row="3"
                               Grid.Column="2"
                               Style="{StaticResource UnitStyle}"/>

                    <GroupBox x:Name="FuelResultGroup"
                              Header="До оплати"
                              Grid.Row="4"
                              Grid.ColumnSpan="3"
                              Margin="0,10,0,0"
                              Padding="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="FuelResult"
                                       Text="0.00"
                                       FontSize="28"
                                       Foreground="#2878D0"/>
                            <TextBlock x:Name="FuelUnit"
                                       Text="грн"
                                       Style="{StaticResource UnitStyle}"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,6"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </GroupBox>
            
            <GroupBox Header="☕ Міні-кафе"
                      Grid.Column="1"
                      Grid.Row="0"
                      Margin="7"
                      Padding="10"
                      FontSize="15"
                      Background="White">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Ціна"
                               Grid.Column="1"
                               HorizontalAlignment="Center"
                               Foreground="#65758B"/>

                    <TextBlock Text="Кількість"
                               Grid.Column="2"
                               HorizontalAlignment="Center"
                               Foreground="#65758B"/>

                    <CheckBox x:Name="CoffeeCheck"
                              Content="Кава"
                              Grid.Row="1"
                              VerticalAlignment="Center"
                              Checked="Product_Checked"
                              Unchecked="Product_Checked"/>

                    <TextBox x:Name="CoffeePrice"
                             Grid.Row="1"
                             Grid.Column="1"
                             Text="45"
                             IsEnabled="False"/>

                    <TextBox x:Name="CoffeeCount"
                             Grid.Row="1"
                             Grid.Column="2"
                             Text="1"
                             IsEnabled="False"/>

                    <CheckBox x:Name="HotDogCheck"
                              Content="Хот-дог"
                              Grid.Row="2"
                              VerticalAlignment="Center"
                              Checked="Product_Checked"
                              Unchecked="Product_Checked"/>

                    <TextBox x:Name="HotDogPrice"
                             Grid.Row="2"
                             Grid.Column="1"
                             Text="85"
                             IsEnabled="False"/>

                    <TextBox x:Name="HotDogCount"
                             Grid.Row="2"
                             Grid.Column="2"
                             Text="1"
                             IsEnabled="False"/>

                    <CheckBox x:Name="SandwichCheck"
                              Content="Сендвіч"
                              Grid.Row="3"
                              VerticalAlignment="Center"
                              Checked="Product_Checked"
                              Unchecked="Product_Checked"/>

                    <TextBox x:Name="SandwichPrice"
                             Grid.Row="3"
                             Grid.Column="1"
                             Text="95"
                             IsEnabled="False"/>

                    <TextBox x:Name="SandwichCount"
                             Grid.Row="3"
                             Grid.Column="2"
                             Text="1"
                             IsEnabled="False"/>

                    <CheckBox x:Name="WaterCheck"
                              Content="Вода"
                              Grid.Row="4"
                              VerticalAlignment="Center"
                              Checked="Product_Checked"
                              Unchecked="Product_Checked"/>

                    <TextBox x:Name="WaterPrice"
                             Grid.Row="4"
                             Grid.Column="1"
                             Text="25"
                             IsEnabled="False"/>

                    <TextBox x:Name="WaterCount"
                             Grid.Row="4"
                             Grid.Column="2"
                             Text="1"
                             IsEnabled="False"/>

                    <GroupBox Header="До оплати"
                              Grid.Row="5"
                              Grid.ColumnSpan="3"
                              Margin="0,10,0,0"
                              Padding="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="CafeResult"
                                       Text="0.00"
                                       FontSize="28"
                                       Foreground="#2878D0"/>
                            <TextBlock Text="грн"
                                       Style="{StaticResource UnitStyle}"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,6"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </GroupBox>

            <GroupBox Header="💰 ВСЬОГО до сплати"
                      Grid.Column="0"
                      Grid.ColumnSpan="2"
                      Grid.Row="1"
                      Margin="7"
                      Padding="10"
                      FontSize="15"
                      Background="White">

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🤑"
                                   FontSize="44"
                                   VerticalAlignment="Center"
                                   Margin="5,0,10,0"/>

                        <Button Content="Прорахувати"
                                Grid.Column="1"
                                Width="200"
                                Height="55"
                                Click="CalculateButton_Click"/>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="GrandTotal"
                                       Text="0.00"
                                       FontSize="34"
                                       Foreground="#2878D0"/>
                            <TextBlock Text="грн"
                                       Style="{StaticResource UnitStyle}"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,8"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="RevenueText"
                               Text="Виручка за день: 0.00 грн"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#20334D"
                               HorizontalAlignment="Center"
                               Margin="5,15,5,5"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl>