<Window x:Class="lb9.Views.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Дані студента"
        Width="420"
        SizeToContent="Height"
        MaxHeight="700"
        MinHeight="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Інформація про студента"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#26344A"
                       Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1">

                <TextBlock Text="Прізвище"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged}"
                         Height="35"
                         FontSize="14"
                         Padding="8"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Ім'я"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Height="35"
                         FontSize="14"
                         Padding="8"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Вік"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}"
                         Height="35"
                         FontSize="14"
                         Padding="8"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Стать"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <ComboBox ItemsSource="{Binding GenderOptions}"
                          SelectedItem="{Binding Gender}"
                          Height="35"
                          FontSize="14"
                          Padding="5"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C0392B"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"/>

            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button Content="Скасувати"
                        Command="{Binding CancelCommand}"
                        Width="110"
                        Height="36"
                        Margin="0,0,10,0"
                        Background="#DCE2EB"
                        BorderThickness="0"/>

                <Button Content="Зберегти"
                        Command="{Binding SaveCommand}"
                        Width="110"
                        Height="36"
                        Background="#315C91"
                        Foreground="White"
                        BorderThickness="0"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>